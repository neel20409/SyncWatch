# Neon PostgreSQL Connection String (Vercel / Neon Postgres)
POSTGRES_URL=postgres://default:xxx@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Or standard DATABASE_URL
# DATABASE_URL=postgres://default:xxx@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Fallback MongoDB Connection String (if Postgres is not set)
MONGODB_URI=mongodb://localhost:27017/yt-watch-party

# JWT Secret - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google OAuth 2.0 Credentials (Get from Google Cloud Console > APIs & Services > Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Render / Deployment environment variables
# Set this to your deployed Render URL (e.g. https://syncwatch-gzdy.onrender.com)
NEXT_PUBLIC_SITE_URL=https://syncwatch-gzdy.onrender.com

# Optional: Dedicated Socket backend URL if hosted separately (e.g. Vercel frontend + Render backend)
# NEXT_PUBLIC_SOCKET_URL=https://syncwatch-backend.onrender.com

# Optional: Allowed CORS Origins (comma-separated if multiple, default: *)
# CORS_ORIGIN=https://syncwatch.vercel.app,https://syncwatch.onrender.com
